    {
      "id": "l1.telefon-dialog",
      "title": "Am Telefon: Falsch verbunden",
      "subtitle": "Lesen · Telefon",
      "lines": [
        { "who": "Herr Kraus", "de": "Kraus, guten Tag.", "tr": "Kraus, iyi günler." },
        { "who": "Eleni", "de": "Guten Tag, hier ist Eleni Dumitru. Ist da Multilingua?", "tr": "İyi günler, ben Eleni Dumitru. Multilingua mı orası?" },
        { "who": "Herr Kraus", "de": "Nein, hier ist Kraus. Welche Nummer haben Sie?", "tr": "Hayır, burası Kraus. Hangi numarayı aradınız?" },
        { "who": "Eleni", "de": "089 22 11 33.", "tr": "089 22 11 33." },
        { "who": "Herr Kraus", "de": "Das ist falsch. Hier ist 089 22 11 32.", "tr": "Yanlış. Burası 089 22 11 32." },
        { "who": "Eleni", "de": "Oh, Entschuldigung! Auf Wiederhören.", "tr": "Ah, özür dilerim! Hoşça kalın (telefonda)." }
      ],
      "items": [
        { "id": "q1", "kind": "truefalse", "prompt": "Eleni spricht mit Multilingua.", "answer": false, "explain": "Yanlış numara: Herr Kraus'u aramış." },
        { "id": "q2", "kind": "choice", "prompt": "Wie ist die Nummer von Herrn Kraus?", "options": [{ "text": "089 22 11 32", "correct": true }, { "text": "089 22 11 33", "correct": false }, { "text": "089 23 11 32", "correct": false }], "explain": "„Hier ist 089 22 11 32.“" },
        { "id": "q3", "kind": "choice", "prompt": "Was sagt man am Telefon zum Abschied?", "options": [{ "text": "Auf Wiederhören.", "correct": true }, { "text": "Guten Morgen.", "correct": false }, { "text": "Herzlich willkommen.", "correct": false }], "explain": "Telefonda vedalaşma: „Auf Wiederhören“ (duymak = hören)." }
      ]
