      ]
    },
    {
      "id": "l1.chat-tolga",
      "title": "Chat: Tolga und Dana",
      "subtitle": "Lesen · Chat",
      "lines": [
        { "who": "Tolga", "de": "Hallo! Ich bin Tolga. Wer bist du?", "tr": "Merhaba! Ben Tolga. Sen kimsin?" },
        { "who": "Dana", "de": "Hallo Tolga, ich heiße Dana.", "tr": "Merhaba Tolga, adım Dana." },
        { "who": "Tolga", "de": "Woher kommst du, Dana?", "tr": "Nereden geliyorsun Dana?" },
        { "who": "Dana", "de": "Aus Polen, aus Krakau. Und du?", "tr": "Polonya'dan, Krakov'dan. Ya sen?" },
        { "who": "Tolga", "de": "Ich komme aus der Türkei, aus Antalya. Ich wohne jetzt in München.", "tr": "Türkiye'den, Antalya'dan geliyorum. Şimdi Münih'te oturuyorum." },
        { "who": "Dana", "de": "Ich auch! Bis Montag im Kurs. Tschüs!", "tr": "Ben de! Pazartesi kursta görüşürüz. Hoşça kal!" }
      ],
      "items": [
        { "id": "q1", "kind": "choice", "prompt": "Woher kommt Dana?", "options": [{ "text": "aus Polen", "correct": true }, { "text": "aus der Türkei", "correct": false }, { "text": "aus Deutschland", "correct": false }], "explain": "„Aus Polen, aus Krakau.“" },
        { "id": "q2", "kind": "truefalse", "prompt": "Tolga und Dana wohnen in München.", "answer": true, "explain": "Tolga: „Ich wohne jetzt in München.“ Dana: „Ich auch!“" },
        { "id": "q3", "kind": "choice", "prompt": "Was sagt Dana am Ende?", "options": [{ "text": "Tschüs!", "correct": true }, { "text": "Guten Morgen!", "correct": false }, { "text": "Herzlich willkommen!", "correct": false }], "explain": "Vedalaşma: „Tschüs!“" }
      ]
    },
