        { "de": "Anmeldung: Frau Nowak, Telefon 089 221133", "tr": "Kayıt: Bayan Nowak, telefon 089 221133" },
        { "de": "Bitte das Formular ausfüllen. Danke!", "tr": "Lütfen formu doldurun. Teşekkürler!" }
      ],
      "items": [
        { "id": "q1", "kind": "choice", "prompt": "Wer ist die Kursleiterin?", "options": [{ "text": "Frau Bauer", "correct": true }, { "text": "Frau Nowak", "correct": false }, { "text": "Frau Dumitru", "correct": false }], "explain": "„Kursleiterin: Frau Anne Bauer“. Frau Nowak kayıt için." },
        { "id": "q2", "kind": "truefalse", "prompt": "Der Kurs ist am Freitag.", "answer": false, "explain": "Montag und Mittwoch – cuma yok." },
