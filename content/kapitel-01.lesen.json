    {
      "id": "l1.email-kurs",
      "title": "E-Mail an die Kursleiterin",
      "subtitle": "Lesen · E-Mail",
      "lines": [
        { "de": "Guten Tag, Frau Bauer,", "tr": "İyi günler Bayan Bauer," },
        { "de": "ich heiße Pablo Puente und komme aus Spanien, aus Sevilla.", "tr": "adım Pablo Puente, İspanya'dan, Sevilla'dan geliyorum." },
        { "de": "Ich wohne jetzt in München.", "tr": "Şimdi Münih'te oturuyorum." },
        { "de": "Meine Telefonnummer ist 0176 4455 2211.", "tr": "Telefon numaram 0176 4455 2211." },
        { "de": "Der Kurs ist am Montag, richtig?", "tr": "Kurs pazartesi, doğru mu?" },
        { "de": "Viele Grüße, Pablo", "tr": "Selamlar, Pablo" }
      ],
      "items": [
        { "id": "q1", "kind": "choice", "prompt": "Wer schreibt die E-Mail?", "options": [{ "text": "Pablo", "correct": true }, { "text": "Frau Bauer", "correct": false }, { "text": "Eleni", "correct": false }], "explain": "„ich heiße Pablo Puente“ – e-postayı Pablo yazıyor." },
        { "id": "q2", "kind": "choice", "prompt": "Woher kommt Pablo?", "options": [{ "text": "aus Spanien", "correct": true }, { "text": "aus München", "correct": false }, { "text": "aus Rumänien", "correct": false }], "explain": "„komme aus Spanien, aus Sevilla“." },
        { "id": "q3", "kind": "truefalse", "prompt": "Pablo fragt: Ist der Kurs am Montag?", "answer": true, "explain": "„Der Kurs ist am Montag, richtig?“" }
      ]
    },
    {
