    {
      "id": "l1.erster-kurstag",
      "title": "Der erste Kurstag",
      "subtitle": "Lesen · Erzählung",
      "lines": [
        { "de": "Heute ist Montag. Es ist 18 Uhr.", "tr": "Bugün pazartesi. Saat 18." },
        { "de": "Eleni kommt in den Kurs und sagt: „Guten Abend!“", "tr": "Eleni kursa geliyor ve „İyi akşamlar!“ diyor." },
        { "de": "Frau Bauer sagt: „Herzlich willkommen, Frau Dumitru!“", "tr": "Bayan Bauer: „Hoş geldiniz Bayan Dumitru!“ diyor." },
        { "de": "Dann kommt Pablo. Er sagt: „Hallo, ich bin Pablo. Ich komme aus Spanien.“", "tr": "Sonra Pablo geliyor. „Merhaba, ben Pablo. İspanya'dan geliyorum.“ diyor." },
        { "de": "Eleni fragt: „Wo wohnst du jetzt?“ – „In München, in Pasing.“", "tr": "Eleni soruyor: „Şimdi nerede oturuyorsun?“ – „Münih'te, Pasing'de.“" },
        { "de": "Um 20 Uhr ist der Kurs zu Ende. „Tschüs, bis Mittwoch!“", "tr": "Saat 20'de kurs bitiyor. „Hoşça kal, çarşambaya!“" }
      ],
      "items": [
        { "id": "q1", "kind": "choice", "prompt": "Was sagt Eleni um 18 Uhr?", "options": [{ "text": "Guten Abend!", "correct": true }, { "text": "Guten Morgen!", "correct": false }, { "text": "Gute Nacht!", "correct": false }], "explain": "Saat 18, akşam: „Guten Abend!“" },
        { "id": "q2", "kind": "choice", "prompt": "Wo wohnt Pablo?", "options": [{ "text": "in München-Pasing", "correct": true }, { "text": "in Spanien", "correct": false }, { "text": "in Augsburg", "correct": false }], "explain": "„In München, in Pasing.“" },
        { "id": "q3", "kind": "truefalse", "prompt": "Der nächste Kurstag ist Mittwoch.", "answer": true, "explain": "„Tschüs, bis Mittwoch!“" }
      ]
    }
